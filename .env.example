# Copy to .env.local and adjust. All values are optional; defaults live in src/config/site.ts.
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time, so never put secrets here.

# Public origin of the console, used for metadata and absolute URLs.
NEXT_PUBLIC_SITE_URL=https://app.youtorch.ai

# Base URL shown in code samples and used by the SDK examples.
NEXT_PUBLIC_API_BASE_URL=https://api.youtorch.ai/v1

# Documentation site linked from the sidebar and model pages.
NEXT_PUBLIC_DOCS_URL=https://docs.youtorch.ai
