# Keys of the modelvend-secrets Kubernetes secret. Copy this outside the repository and fill it in; values never enter Git.
#
#   kubectl -n modelvend create secret generic modelvend-secrets --from-env-file=<your copy>
#   deploy/secrets/check.sh modelvend

# Sign-in for the admin UI while it serves the mock (apps.admin.mock); 12 characters or more.
ADMIN_API_MOCK_PASSWORD=

# Bunny Storage, needed once storage.endpoint is set.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Only with postgres.enabled=false.
#DATABASE_URL=
