# Settings for the local stack in deploy/compose.dev.yaml. These are throwaway local values, not secrets.
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text
DATABASE_URL=postgres://modelvend:modelvend@127.0.0.1:55440/modelvend?sslmode=disable
TEST_DATABASE_URL=postgres://modelvend:modelvend@127.0.0.1:55440/postgres?sslmode=disable
REDIS_URL=redis://127.0.0.1:56379/0
PUBLIC_API_URL=http://localhost:8080
STORAGE_ENDPOINT=127.0.0.1:59000
STORAGE_BUCKET=modelvend-media
STORAGE_ACCESS_KEY=modelvend
STORAGE_SECRET_KEY=modelvend-dev
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://127.0.0.1:59000/modelvend-media
