# The build context is the repository root; patterns are relative to it.
# Keep only the root manifests, this app and the workspace packages it depends on.
*
!package.json
!package-lock.json
!apps/admin
!packages/admin-api
!packages/api-types
!packages/config-eslint
!packages/config-typescript
**/node_modules
**/.next
**/npm-debug.log*
**/.env*
!apps/admin/.env.example
**/*.tsbuildinfo
**/next-env.d.ts
apps/admin/Dockerfile*
