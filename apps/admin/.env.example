# Copy to .env.local and adjust. All values are optional in development.
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time, so never put secrets here.

# Where /api/* is forwarded (the Go admin API). Unset in development: the in-memory mock answers instead.
# ADMIN_API_URL=http://localhost:8081

# How many proxies in front of the console append to X-Forwarded-For; the operator's address is taken from there.
# TRUSTED_PROXY_HOPS=1

# Name shown in the sidebar and page titles.
NEXT_PUBLIC_CONSOLE_NAME=Modelvend Admin

# The customer console, for "Open in the console" links.
NEXT_PUBLIC_CONSOLE_URL=https://app.modelvend.ai

# Public API base shown in example calls.
NEXT_PUBLIC_API_BASE_URL=https://api.modelvend.ai/v1
